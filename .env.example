# Copy to .env for local development. In development the app reads .env automatically; real environment variables override it;
# it is ignored in production (set variables in Railway instead). .env is git-ignored. NEVER commit real secrets.
# Local "try it without AWS or SSO" settings:
AUTH_MODE=dev
AWS_MODE=fake
DEV_USER_NAME=Local Admin
DEV_USER_EMAIL=admin@example.com
SECRET_KEY=change-me-for-anything-but-local

# Only Google Workspace accounts of this domain may sign in (AUTH_MODE=google)
ALLOWED_DOMAIN=life180labs.com

# ---- Google sign-in (AUTH_MODE=google; this is the production default) ----
# AUTH_MODE=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public address of this app, no path. Must use the same host as the redirect URI registered in Google Cloud
# (<PUBLIC_BASE_URL>/auth/callback). Required, and must be https, in production.
# PUBLIC_BASE_URL=https://panel.example.com
# For trying real Google locally use http://localhost:5000 and open the app at localhost, not 127.0.0.1

# Clients: inline JSON wins over a file. Dev falls back to clients.example.json.
# CLIENTS_FILE=clients.json
# CLIENTS_JSON={"clients":[...]}

# Tuning (defaults shown)
# STATUS_CACHE_TTL=3
# OP_POLL_INTERVAL=5
# OP_WAIT_TIMEOUT=1800
# RATE_LIMIT_READ=240 per minute
# RATE_LIMIT_WRITE=30 per minute
# RATE_LIMIT_LOGIN=20 per minute
# SESSION_HOURS=12
# FAKE_SPEED=1.0        # below 1 makes the fake AWS faster

# Real AWS (AWS_MODE=real): standard boto3 variables for the IAM user that assumes client roles
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
