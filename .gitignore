# ---------------------------------------------------------------------------
# Secrets and local configuration: never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc

# Real client / AWS resource IDs. The committed template is clients.example.json
/clients.json

# AWS and TLS credentials, in case one lands in the folder by accident
.aws/
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.keystore
credentials
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyflakes/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Local data (e.g. a SQLite audit log or scratch database during development)
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# Test and audit artefacts (regenerated by `pytest` and scripts/ui_audit.py)
# ---------------------------------------------------------------------------
/shots/
test-results/
playwright-report/
.playwright/

# ---------------------------------------------------------------------------
# Logs, scratch and merge leftovers
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.orig
*.rej
tmp/

# ---------------------------------------------------------------------------
# Editors, OS and assistant-local files
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
